<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:allowBackup="false"
        android:label="TV agent"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- The remote's mic button (KEYCODE_SEARCH, mapped by the launcher's app_keys) opens this. It records
             until you stop talking, sends the audio to tv-agent on the computer, shows the reply and closes. -->
        <activity
            android:name=".ListenActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.boujuan.tvagent.overlay"
            android:noHistory="true"
            android:theme="@style/Listen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- A numbered list from tv-agent ("what was I watching?"): "number 2" or OK picks. Opened over adb only,
             like the screens below. It shares the pill's task, so the pill opens on top of it and the list stays
             visible behind it while you say a number (in separate tasks Android stops the list). -->
        <activity
            android:name=".ChoicesActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.boujuan.tvagent.overlay"
            android:permission="android.permission.DUMP"
            android:theme="@style/Choices" />

        <!-- Phase 0 microphone probe and the agent's on-screen messages: only shell (adb) can reach these,
             since it holds DUMP and ordinary apps can't. -->
        <activity
            android:name=".ProbeActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:permission="android.permission.DUMP" />

        <receiver
            android:name=".SayReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <!-- Pairing: `tv-agent tv pair` sends the agent's address and token (shell only, like the above). -->
        <receiver
            android:name=".ConfigReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
