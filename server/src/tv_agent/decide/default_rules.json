{
  "version": 2,
  "normalize": {
    "fillers": [
      "hey tv",
      "hey telly",
      "hey agent",
      "ok tv",
      "okay tv",
      "ok telly",
      "okay telly",
      "ok agent",
      "okay agent",
      "please",
      "can you",
      "could you",
      "would you",
      "um",
      "uh",
      "erm",
      "er",
      "hmm",
      "so",
      "okay so",
      "right",
      "okay",
      "ok",
      "alright",
      "all right",
      "well",
      "hey",
      "now",
      "oh",
      "yeah",
      "and then",
      "and",
      "then"
    ],
    "remove_words": [
      "please"
    ],
    "fixes": [
      {
        "from": "^got to\\b",
        "to": "go to",
        "note": "a common mishearing of “go to”"
      },
      {
        "from": "\\bun ?pause\\b",
        "to": "unpause",
        "note": "speech-to-text splits “unpause”"
      },
      {
        "from": "\\bun ?mute\\b",
        "to": "unmute",
        "note": "and “unmute”"
      },
      {
        "from": "[,\\s]+(?:now|thanks|thank you|right now|for me)$",
        "to": "",
        "note": "politeness at the end (“pause now”, “next episode thanks”)"
      },
      {
        "from": "^(?:clay|klay|blay|flay)\\b",
        "to": "play",
        "note": "the remote's mic opens a moment late and clips the “p” of “play”"
      }
    ]
  },
  "phrases": [
    {
      "id": "pause",
      "say": [
        "pause",
        "pause it",
        "hold on",
        "please",
        "please please",
        "pause this",
        "pause the movie",
        "pause the show",
        "pause the episode",
        "pause the video",
        "wait",
        "wait a second",
        "wait a moment",
        "hold on a second",
        "hold on a moment",
        "hold it",
        "pause for a moment",
        "pause for a second",
        "can you pause"
      ],
      "do": {
        "type": "transport",
        "op": "pause"
      },
      "note": "speech-to-text often hears “pause please” as “please please”"
    },
    {
      "id": "resume",
      "say": [
        "resume",
        "unpause",
        "play",
        "continue",
        "keep playing",
        "resume playback",
        "resume the movie",
        "resume the show",
        "resume the episode",
        "resume the video",
        "resume it",
        "play it",
        "play again",
        "go on",
        "carry on",
        "keep going",
        "start playing again",
        "continue playing",
        "unpause it",
        "play the movie",
        "play the show",
        "play the video"
      ],
      "do": {
        "type": "transport",
        "op": "resume"
      }
    },
    {
      "id": "stop",
      "say": [
        "stop",
        "stop it",
        "stop playing",
        "stop the movie",
        "stop playback",
        "stop the episode",
        "stop the show",
        "stop the video",
        "stop watching"
      ],
      "do": {
        "type": "transport",
        "op": "stop"
      }
    },
    {
      "id": "start_over",
      "say": [
        "start over",
        "from the beginning",
        "restart",
        "start it again",
        "start this over",
        "start it over",
        "start again",
        "from the start",
        "start from the beginning",
        "go to the beginning",
        "back to the beginning",
        "rewind to the beginning",
        "rewind to the start",
        "play it from the beginning",
        "play from the start"
      ],
      "do": {
        "type": "transport",
        "op": "seek_to",
        "seconds": 0
      }
    },
    {
      "id": "mute",
      "say": [
        "mute",
        "silence",
        "mute it",
        "mute the tv",
        "mute the sound",
        "mute the volume",
        "silence it"
      ],
      "do": {
        "type": "volume",
        "op": "mute"
      }
    },
    {
      "id": "unmute",
      "say": [
        "unmute",
        "sound on",
        "sound back",
        "unmute it",
        "unmute the tv",
        "turn the sound back on",
        "sound back on"
      ],
      "do": {
        "type": "volume",
        "op": "unmute"
      }
    },
    {
      "id": "home",
      "say": [
        "home",
        "go home",
        "home screen",
        "go to the home screen",
        "take me home",
        "go to home",
        "back to the home screen",
        "go back home",
        "go back to the home screen",
        "main menu",
        "home page"
      ],
      "do": {
        "type": "home"
      }
    },
    {
      "id": "next_episode",
      "say": [
        "next episode",
        "play the next episode",
        "next",
        "skip episode",
        "skip this episode",
        "play next episode",
        "next one",
        "play the next one",
        "the next episode",
        "go to the next episode",
        "skip to the next episode",
        "start the next episode",
        "watch the next episode",
        "put on the next episode",
        "play next"
      ],
      "do": {
        "type": "next_episode"
      }
    },
    {
      "id": "volume_up",
      "say": [
        "i can't hear",
        "i can't hear anything",
        "i can't hear it",
        "it's too quiet",
        "too quiet",
        "i can barely hear it"
      ],
      "do": {
        "type": "volume",
        "op": "up"
      },
      "note": "complaints that mean louder"
    }
  ],
  "patterns": [
    {
      "id": "previous_episode",
      "stage": "grammar",
      "match": "^(?:play |go to |go back to |watch |put on )?(?:the )?(?:previous|last|prior) (?:episode|one)(?: again)?$|^(?:go )?back (?:an|one) episode$|^previous$|^(?:play |go to )?the episode before(?: this(?: one)?)?$",
      "do": {
        "type": "next_episode",
        "offset": -1
      }
    },
    {
      "id": "to_start",
      "stage": "grammar",
      "match": "^(?:(?:go|jump|skip|back|go back|take me back|rewind|rewind it|get back) to (?:the )?(?:beginning|start)|start (?:it |this )?from (?:the )?(?:beginning|start|top)|from the top|restart|start (?:it |this )?(?:over|again)|play (?:it|this) from the (?:start|beginning))(?: of (?:it|this(?: \\w+)?|the \\w+))?$",
      "do": {
        "type": "transport",
        "op": "seek_to",
        "seconds": 0
      }
    },
    {
      "id": "to_middle",
      "stage": "grammar",
      "match": "^(?:go|jump|skip) to (?:the )?(?:middle|half ?way(?: point)?)(?: of (?:it|this(?: \\w+)?|the \\w+(?: \\w+)?))?$",
      "do": {
        "type": "transport",
        "op": "seek_to",
        "percent": 50
      }
    },
    {
      "id": "episode_of_this_show",
      "stage": "grammar",
      "match": "^(?P<all>.*\\b(?:season|series|episode|ep|s\\d+\\s*e\\d+)\\b.*)$",
      "do": {
        "type": "play_title",
        "*": "{all|episode_here!}"
      },
      "note": "only when no title is said: the show that's on"
    },
    {
      "id": "skip_to_next_episode",
      "stage": "grammar",
      "match": "^(?:skip|fast forward|forward|go forward|jump forward|skip ahead)\\b.*\\bepisode\\b.*$",
      "do": {
        "type": "next_episode"
      }
    },
    {
      "id": "seek_forward",
      "stage": "grammar",
      "match": "^(?:skip forward|skip ahead|fast forward|go forward|jump forward|jump ahead|forward|ahead|skip(?! (?:back|to)\\b))\\b(?:\\s+(?:by\\s+)?(?P<amount>.+))?$",
      "do": {
        "type": "transport",
        "op": "forward",
        "seconds": "{amount|seconds}"
      },
      "note": "not “skip back …” or “skip to …”, which come next"
    },
    {
      "id": "back_a_bit",
      "stage": "grammar",
      "match": "^(?:go back|rewind|back up|skip back|jump back)(?: (?:a (?:little )?bit|a little|a few seconds|some))$",
      "do": {
        "type": "transport",
        "op": "back"
      },
      "note": "back by the default amount"
    },
    {
      "id": "seek_back",
      "stage": "grammar",
      "match": "^(?:go back|skip back|jump back|back up|rewind|back)\\b(?:\\s+(?:by\\s+)?(?P<amount>.+))?$",
      "do": {
        "type": "transport",
        "op": "back",
        "seconds": "{amount|seconds!}"
      },
      "note": "“go back to the menu” has no duration, so it doesn't match"
    },
    {
      "id": "seek_to",
      "stage": "grammar",
      "match": "^(?:go to|jump to|skip to|seek to)\\s+(?:minute\\s+)?(?P<at>.+)$",
      "do": {
        "type": "transport",
        "op": "seek_to",
        "seconds": "{at|time!}"
      }
    },
    {
      "id": "volume_set",
      "stage": "grammar",
      "match": "^(?:set (?:the )?)?volume(?: to| at| level)? (?P<level>.+)$",
      "do": {
        "type": "volume",
        "op": "set",
        "amount": "{level|number!}"
      }
    },
    {
      "id": "volume_to",
      "stage": "grammar",
      "match": "^(?:increase|decrease|raise|lower|turn|put|change|bring|set)(?: (?:up|down))? (?:the )?(?:volume|sound)(?: (?:up|down))? (?:to|at) (?P<level>.+)$",
      "do": {
        "type": "volume",
        "op": "set",
        "amount": "{level|number!}"
      },
      "note": "“increase the volume to fifty”"
    },
    {
      "id": "volume_by_feel",
      "stage": "grammar",
      "match": "^(?P<how>a lot|a (?:little )?bit|a little|slightly|much|way) (?P<dir>louder|higher|quieter|softer|lower)$",
      "do": {
        "type": "volume",
        "op": "{dir|direction!}",
        "amount": "{how|amount}"
      },
      "note": "“a bit louder”, “much quieter”"
    },
    {
      "id": "volume_up",
      "stage": "grammar",
      "match": "^(?:volume up|louder|turn (?:it|the volume|the sound) up|turn up (?:the )?(?:volume|sound)|more volume|raise (?:the )?volume)\\b(?P<how>.*)$",
      "do": {
        "type": "volume",
        "op": "up",
        "amount": "{how|amount}"
      }
    },
    {
      "id": "volume_down",
      "stage": "grammar",
      "match": "^(?:volume down|quieter|softer|lower (?:the )?volume|turn (?:it|the volume|the sound) down|turn down (?:the )?(?:volume|sound)|less volume)\\b(?P<how>.*)$",
      "do": {
        "type": "volume",
        "op": "down",
        "amount": "{how|amount}"
      }
    },
    {
      "id": "youtube_on",
      "stage": "cue",
      "match": "^(?:search youtube for|youtube search for|find on youtube|search for|search|look up|find|play|put on|put|watch|show me)?\\s*(?P<q>.+?)\\s+on\\s+(?:youtube|you tube)$",
      "do": {
        "type": "youtube",
        "query": "{q|query!}"
      }
    },
    {
      "id": "youtube_first",
      "stage": "cue",
      "match": "^(?:search )?(?:youtube|you tube)(?: for)?\\s+(?P<q>.+)$",
      "do": {
        "type": "youtube",
        "query": "{q|query!}"
      }
    },
    {
      "id": "twitch_on",
      "stage": "cue",
      "match": "^(?:put on|put|watch|open|play|show me)?\\s*(?P<ch>.+?)\\s+on\\s+twitch$",
      "do": {
        "type": "twitch",
        "channel": "{ch|text!}"
      }
    },
    {
      "id": "twitch_first",
      "stage": "cue",
      "match": "^twitch\\s+(?P<ch>.+)$",
      "do": {
        "type": "twitch",
        "channel": "{ch|text!}"
      }
    },
    {
      "id": "stremio_page",
      "stage": "cue",
      "match": "^(?:show me|show|open|find)?\\s*(?P<what>.+?)\\s+(?:in|on)\\s+stremio$",
      "do": {
        "type": "open_in_stremio",
        "*": "{what|title!}"
      }
    },
    {
      "id": "open_app",
      "stage": "cue",
      "match": "^(?:open|launch|start|go to|go back to|back to|return to|switch to|switch back to|take me to)\\s+(?:the\\s+)?(?P<name>.+?)(?:\\s+app)?$",
      "do": {
        "type": "open_app",
        "app": "{name|app!}"
      }
    },
    {
      "id": "app_by_name",
      "stage": "cue",
      "match": "^(?P<name>.+)$",
      "do": {
        "type": "open_app",
        "app": "{name|alias!}"
      },
      "note": "just an app's name: “twitch”"
    },
    {
      "id": "continue",
      "stage": "cue",
      "match": "^(?:continue|resume|keep watching|carry on with|carry on|finish|go on with)\\s*(?:watching\\s+)?(?P<rest>.*)$",
      "do": {
        "type": "continue_watching",
        "title": "{rest|continue}"
      }
    },
    {
      "id": "play_title",
      "stage": "cue",
      "match": "^(?:i(?:'d| would) like to (?:watch|see)|i (?:want|wanna) (?:to )?(?:watch|see)|i wanna (?:watch|see)|let'?s (?:watch|see|put on)|can we (?:watch|see)|play|put on|put|watch|start|stream)\\s+(?P<what>.+)$",
      "do": {
        "type": "play_title",
        "*": "{what|play!}"
      },
      "note": "“play / put on / watch / start” + a title: played, even when the title is “Up” or “Stop Making Sense”"
    },
    {
      "id": "title_with_episode",
      "stage": "cue",
      "match": "^(?P<all>.+\\b(?:season|episode|ep|s\\d+\\s*e\\d+)\\b.*)$",
      "do": {
        "type": "play_title",
        "*": "{all|play!}"
      },
      "note": "a title said with a season or episode, without “play” (“community season two episode two”)"
    }
  ],
  "model": {
    "question": "A spoken command to a TV, transcribed by speech recognition (it may contain recognition errors). Which action does the user want?",
    "min_confidence": 0.65,
    "min_ratio": 2.0,
    "offline_fallback": "play_title",
    "title_question": "Which title does the user most likely mean?",
    "title_candidates": 4,
    "intents": {
      "play_title": {
        "describe": "play a named movie or series, maybe a given season or episode (e.g. 'play the bear season 3 episode 2')"
      },
      "continue_watching": {
        "describe": "continue a named title, or whatever was watched last, from where it was left (e.g. 'continue severance')"
      },
      "next_episode": {
        "describe": "go to the next episode of what is playing (e.g. 'next episode')"
      },
      "previous_episode": {
        "describe": "go back to the previous episode of what is playing (e.g. 'previous episode')"
      },
      "open_in_stremio": {
        "describe": "show a title's page in Stremio without playing it (e.g. 'open the office in stremio')"
      },
      "youtube": {
        "describe": "play or search something on YouTube (e.g. 'lofi on youtube')"
      },
      "twitch": {
        "describe": "watch a streamer's channel on Twitch (e.g. 'put ibai on twitch')"
      },
      "open_app": {
        "describe": "open an app such as YouTube, Stremio, Twitch, Movistar+, Prime Video, Kodi or Settings (e.g. 'open stremio')"
      },
      "home": {
        "describe": "go to the TV's home screen (e.g. 'go home')"
      },
      "pause": {
        "describe": "pause what is playing (e.g. 'pause')"
      },
      "resume": {
        "describe": "resume or unpause what is paused (e.g. 'play')"
      },
      "stop": {
        "describe": "stop playback (e.g. 'stop')"
      },
      "skip_forward": {
        "describe": "skip forward by an amount of time (e.g. 'skip 30 seconds')"
      },
      "skip_back": {
        "describe": "go back by an amount of time (e.g. 'go back 10 seconds')"
      },
      "seek_to": {
        "describe": "jump to a specific time or point of the current video (e.g. 'go to twelve minutes')"
      },
      "restart": {
        "describe": "start the current video again from the beginning (e.g. 'start over')"
      },
      "volume_set": {
        "describe": "set the volume to a number (e.g. 'volume twenty')"
      },
      "volume_up": {
        "describe": "make it louder (e.g. 'louder')"
      },
      "volume_down": {
        "describe": "make it quieter (e.g. 'volume down')"
      },
      "mute": {
        "describe": "mute the sound (e.g. 'mute')"
      },
      "unmute": {
        "describe": "unmute the sound (e.g. 'unmute')"
      },
      "none": {
        "describe": "not a TV command, or not understandable (e.g. 'what time is it')"
      }
    }
  },
  "apps": [
    {
      "key": "tizentube",
      "label": "TizenTube",
      "package": "io.gh.reisxd.tizentube.cobalt",
      "activity": "dev.cobalt.app.MainActivity",
      "aliases": [
        "youtube",
        "you tube",
        "tizentube",
        "tizen tube"
      ]
    },
    {
      "key": "stremio",
      "label": "Stremio",
      "package": "com.stremio.one",
      "activity": "com.stremio.tv.MainActivity",
      "aliases": [
        "stremio",
        "stream io"
      ]
    },
    {
      "key": "kodi",
      "label": "Kodi",
      "package": "org.xbmc.kodi",
      "activity": ".Splash",
      "aliases": [
        "kodi",
        "codey",
        "cody"
      ]
    },
    {
      "key": "twitch",
      "label": "Twitch",
      "package": "tv.twitch.android.app",
      "activity": "tv.twitch.starshot64.app.StarshotActivity",
      "aliases": [
        "twitch"
      ]
    },
    {
      "key": "movistar",
      "label": "Movistar+",
      "package": "com.movistarplus.androidtv",
      "activity": ".MainActivity",
      "aliases": [
        "movistar",
        "movistar plus",
        "movistar tv"
      ]
    },
    {
      "key": "prime",
      "label": "Prime Video",
      "package": "com.amazon.amazonvideo.livingroom",
      "activity": "com.amazon.ignition.IgnitionActivity",
      "aliases": [
        "prime",
        "prime video",
        "amazon",
        "amazon prime"
      ]
    }
  ],
  "hooks": {
    "youtube": {
      "app": "tizentube",
      "link": "https://www.youtube.com/watch?v={id}"
    },
    "twitch": {
      "app": "twitch",
      "link": "twitch://stream/{channel}"
    },
    "stremio": {
      "app": "stremio",
      "link": "stremio:///detail/{type}/{id}",
      "link_episode": "stremio:///detail/{type}/{id}/{video}"
    }
  }
}
