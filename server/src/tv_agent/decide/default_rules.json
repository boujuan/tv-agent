{
  "version": 2,
  "normalize": {
    "fillers": [
      "hey tv",
      "hey telly",
      "hey agent",
      "ok tv",
      "okay tv",
      "ok telly",
      "okay telly",
      "ok agent",
      "okay agent",
      "please",
      "can you",
      "could you",
      "would you",
      "um",
      "uh",
      "erm",
      "er",
      "hmm",
      "so",
      "okay so",
      "right",
      "okay",
      "ok",
      "alright",
      "all right",
      "well",
      "hey",
      "now",
      "oh",
      "yeah",
      "and then",
      "and",
      "then"
    ],
    "remove_words": [
      "please"
    ],
    "fixes": [
      {
        "from": "^got to\\b",
        "to": "go to",
        "note": "a common mishearing of “go to”"
      },
      {
        "from": "\\bun ?pause\\b",
        "to": "unpause",
        "note": "speech-to-text splits “unpause”"
      },
      {
        "from": "\\bun ?mute\\b",
        "to": "unmute",
        "note": "and “unmute”"
      },
      {
        "from": "[,\\s]+(?:now|thanks|thank you|right now|for me)$",
        "to": "",
        "note": "politeness at the end (“pause now”, “next episode thanks”)"
      },
      {
        "from": "^(?:clay|klay|blay|flay)\\b",
        "to": "play",
        "note": "the remote's mic opens a moment late and clips the “p” of “play”"
      }
    ]
  },
  "phrases": [
    {
      "id": "pause",
      "say": [
        "pause",
        "pause it",
        "hold on",
        "please",
        "please please",
        "pause this",
        "pause the movie",
        "pause the show",
        "pause the episode",
        "pause the video",
        "wait",
        "wait a second",
        "wait a moment",
        "hold on a second",
        "hold on a moment",
        "hold it",
        "pause for a moment",
        "pause for a second",
        "can you pause"
      ],
      "do": {
        "type": "transport",
        "op": "pause"
      },
      "note": "speech-to-text often hears “pause please” as “please please”"
    },
    {
      "id": "resume",
      "say": [
        "resume",
        "unpause",
        "play",
        "continue",
        "keep playing",
        "resume playback",
        "resume the movie",
        "resume the show",
        "resume the episode",
        "resume the video",
        "resume it",
        "play it",
        "play again",
        "go on",
        "carry on",
        "keep going",
        "start playing again",
        "continue playing",
        "unpause it",
        "play the movie",
        "play the show",
        "play the video"
      ],
      "do": {
        "type": "transport",
        "op": "resume"
      }
    },
    {
      "id": "stop",
      "say": [
        "stop",
        "stop it",
        "stop playing",
        "stop the movie",
        "stop playback",
        "stop the episode",
        "stop the show",
        "stop the video",
        "stop watching"
      ],
      "do": {
        "type": "transport",
        "op": "stop"
      }
    },
    {
      "id": "start_over",
      "say": [
        "start over",
        "from the beginning",
        "restart",
        "start it again",
        "start this over",
        "start it over",
        "start again",
        "from the start",
        "start from the beginning",
        "go to the beginning",
        "back to the beginning",
        "rewind to the beginning",
        "rewind to the start",
        "play it from the beginning",
        "play from the start"
      ],
      "do": {
        "type": "transport",
        "op": "seek_to",
        "seconds": 0
      }
    },
    {
      "id": "mute",
      "say": [
        "mute",
        "silence",
        "mute it",
        "mute the tv",
        "mute the sound",
        "mute the volume",
        "silence it"
      ],
      "do": {
        "type": "volume",
        "op": "mute"
      }
    },
    {
      "id": "unmute",
      "say": [
        "unmute",
        "sound on",
        "sound back",
        "unmute it",
        "unmute the tv",
        "turn the sound back on",
        "sound back on"
      ],
      "do": {
        "type": "volume",
        "op": "unmute"
      }
    },
    {
      "id": "home",
      "say": [
        "home",
        "go home",
        "home screen",
        "go to the home screen",
        "take me home",
        "go to home",
        "back to the home screen",
        "go back home",
        "go back to the home screen",
        "main menu",
        "home page"
      ],
      "do": {
        "type": "home"
      }
    },
    {
      "id": "next_episode",
      "say": [
        "next episode",
        "play the next episode",
        "next",
        "skip episode",
        "skip this episode",
        "play next episode",
        "next one",
        "play the next one",
        "the next episode",
        "go to the next episode",
        "skip to the next episode",
        "start the next episode",
        "watch the next episode",
        "put on the next episode",
        "play next"
      ],
      "do": {
        "type": "next_episode"
      }
    },
    {
      "id": "volume_up",
      "say": [
        "i can't hear",
        "i can't hear anything",
        "i can't hear it",
        "it's too quiet",
        "too quiet",
        "i can barely hear it"
      ],
      "do": {
        "type": "volume",
        "op": "up"
      },
      "note": "complaints that mean louder"
    },
    {
      "id": "timer_cancel",
      "say": [
        "cancel the sleep timer",
        "cancel sleep timer",
        "cancel the timer",
        "stop the timer",
        "no sleep timer",
        "turn off the sleep timer",
        "keep playing after this",
        "keep going after this",
        "don't stop after this episode",
        "cancel that timer"
      ],
      "do": {
        "type": "timer",
        "cancel": true
      }
    },
    {
      "id": "replay",
      "say": [
        "say that again",
        "repeat that",
        "i missed that",
        "i didn't catch that",
        "what did they say",
        "what did he say",
        "what did she say"
      ],
      "do": {
        "type": "replay",
        "seconds": 10
      }
    }
  ],
  "patterns": [
    {
      "id": "previous_episode",
      "stage": "grammar",
      "match": "^(?:play |go to |go back to |watch |put on )?(?:the )?(?:previous|last|prior) (?:episode|one)(?: again)?$|^(?:go )?back (?:an|one) episode$|^previous$|^(?:play |go to )?the episode before(?: this(?: one)?)?$",
      "do": {
        "type": "next_episode",
        "offset": -1
      }
    },
    {
      "id": "to_start",
      "stage": "grammar",
      "match": "^(?:(?:go|jump|skip|back|go back|take me back|rewind|rewind it|get back) to (?:the )?(?:beginning|start)|start (?:it |this )?from (?:the )?(?:beginning|start|top)|from the top|restart|start (?:it |this )?(?:over|again)|play (?:it|this) from the (?:start|beginning))(?: of (?:it|this(?: \\w+)?|the \\w+))?$",
      "do": {
        "type": "transport",
        "op": "seek_to",
        "seconds": 0
      }
    },
    {
      "id": "to_middle",
      "stage": "grammar",
      "match": "^(?:go|jump|skip) to (?:the )?(?:middle|half ?way(?: point)?)(?: of (?:it|this(?: \\w+)?|the \\w+(?: \\w+)?))?$",
      "do": {
        "type": "transport",
        "op": "seek_to",
        "percent": 50
      }
    },
    {
      "id": "episode_of_this_show",
      "stage": "grammar",
      "match": "^(?P<all>.*\\b(?:season|series|episode|ep|s\\d+\\s*e\\d+)\\b.*)$",
      "do": {
        "type": "play_title",
        "*": "{all|episode_here!}"
      },
      "note": "only when no title is said: the show that's on"
    },
    {
      "id": "skip_intro",
      "stage": "grammar",
      "do": {
        "type": "skip",
        "what": "intro"
      },
      "match": "^(?:skip|jump past|jump over|skip past|skip over|get past|go past|fast forward through)\\s+(?:the\\s+|this\\s+)?(?:intro|introduction|opening(?: credits| titles| song| theme)?|theme(?: song| tune)?|title sequence|titles)$",
      "note": "the intro you're in, from TheIntroDB / IntroDB timestamps (or a chapter named so)"
    },
    {
      "id": "skip_recap",
      "stage": "grammar",
      "do": {
        "type": "skip",
        "what": "recap"
      },
      "match": "^(?:skip|jump past|jump over|skip past|skip over|get past|go past|fast forward through)\\s+(?:the\\s+|this\\s+)?(?:recap|previously(?: on)?|summary|catch[ -]?up)$"
    },
    {
      "id": "skip_credits",
      "stage": "grammar",
      "do": {
        "type": "skip",
        "what": "credits"
      },
      "match": "^(?:skip|jump past|jump over|skip past|skip over|get past|go past|fast forward through)\\s+(?:the\\s+|these\\s+)?(?:(?:end(?:ing)?|closing) credits|credits|outro|ending)$",
      "note": "the next episode in binge mode, else stop and Home"
    },
    {
      "id": "auto_skip_on",
      "stage": "grammar",
      "do": {
        "type": "auto_skip",
        "on": true
      },
      "match": "^(?:(?:turn|switch) on|enable|start|activate)\\s+(?:the\\s+)?auto(?:matic)?[ -]?skip(?:ping)?(?:\\s+(?:the\\s+)?(?:intros?|recaps?|intros and recaps))?$|^(?:always skip|auto(?:matically)? skip) (?:the\\s+)?(?:intros?|recaps?|intros and recaps)$|^auto[ -]?skip(?:ping)?(?: on)?$"
    },
    {
      "id": "auto_skip_off",
      "stage": "grammar",
      "do": {
        "type": "auto_skip",
        "on": false
      },
      "match": "^(?:(?:turn|switch) off|disable|stop|deactivate)\\s+(?:the\\s+)?auto(?:matic)?[ -]?skip(?:ping)?(?:\\s+(?:the\\s+)?(?:intros?|recaps?|intros and recaps))?$|^(?:stop|don'?t) (?:automatically )?skip(?:ping)? (?:the\\s+)?(?:intros?|recaps?|intros and recaps)(?: automatically)?$|^auto[ -]?skip(?:ping)? off$"
    },
    {
      "id": "skip_to_next_episode",
      "stage": "grammar",
      "match": "^(?:skip|fast forward|forward|go forward|jump forward|skip ahead)\\b.*\\bepisode\\b.*$",
      "do": {
        "type": "next_episode"
      }
    },
    {
      "id": "seek_forward",
      "stage": "grammar",
      "match": "^(?:skip forward|skip ahead|fast forward|go forward|jump forward|jump ahead|forward|ahead|skip(?! (?:back|to)\\b))\\b(?:\\s+(?:by\\s+)?(?P<amount>.+))?$",
      "do": {
        "type": "transport",
        "op": "forward",
        "seconds": "{amount|seconds}"
      },
      "note": "not “skip back …” or “skip to …”, which come next"
    },
    {
      "id": "back_a_bit",
      "stage": "grammar",
      "match": "^(?:go back|rewind|back up|skip back|jump back)(?: (?:a (?:little )?bit|a little|a few seconds|some))$",
      "do": {
        "type": "transport",
        "op": "back"
      },
      "note": "back by the default amount"
    },
    {
      "id": "seek_back",
      "stage": "grammar",
      "match": "^(?:go back|skip back|jump back|back up|rewind|back)\\b(?:\\s+(?:by\\s+)?(?P<amount>.+))?$",
      "do": {
        "type": "transport",
        "op": "back",
        "seconds": "{amount|seconds!}"
      },
      "note": "“go back to the menu” has no duration, so it doesn't match"
    },
    {
      "id": "seek_to",
      "stage": "grammar",
      "match": "^(?:go to|jump to|skip to|seek to)\\s+(?:minute\\s+)?(?P<at>.+)$",
      "do": {
        "type": "transport",
        "op": "seek_to",
        "seconds": "{at|time!}"
      }
    },
    {
      "id": "volume_set",
      "stage": "grammar",
      "match": "^(?:set (?:the )?)?volume(?: to| at| level)? (?P<level>.+)$",
      "do": {
        "type": "volume",
        "op": "set",
        "amount": "{level|number!}"
      }
    },
    {
      "id": "volume_to",
      "stage": "grammar",
      "match": "^(?:increase|decrease|raise|lower|turn|put|change|bring|set)(?: (?:up|down))? (?:the )?(?:volume|sound)(?: (?:up|down))? (?:to|at) (?P<level>.+)$",
      "do": {
        "type": "volume",
        "op": "set",
        "amount": "{level|number!}"
      },
      "note": "“increase the volume to fifty”"
    },
    {
      "id": "volume_by_feel",
      "stage": "grammar",
      "match": "^(?P<how>a lot|a (?:little )?bit|a little|slightly|much|way) (?P<dir>louder|higher|quieter|softer|lower)$",
      "do": {
        "type": "volume",
        "op": "{dir|direction!}",
        "amount": "{how|amount}"
      },
      "note": "“a bit louder”, “much quieter”"
    },
    {
      "id": "volume_up",
      "stage": "grammar",
      "match": "^(?:volume up|louder|turn (?:it|the volume|the sound) up|turn up (?:the )?(?:volume|sound)|more volume|raise (?:the )?volume)\\b(?P<how>.*)$",
      "do": {
        "type": "volume",
        "op": "up",
        "amount": "{how|amount}"
      }
    },
    {
      "id": "volume_down",
      "stage": "grammar",
      "match": "^(?:volume down|quieter|softer|lower (?:the )?volume|turn (?:it|the volume|the sound) down|turn down (?:the )?(?:volume|sound)|less volume)\\b(?P<how>.*)$",
      "do": {
        "type": "volume",
        "op": "down",
        "amount": "{how|amount}"
      }
    },
    {
      "id": "binge_on",
      "stage": "grammar",
      "do": {
        "type": "binge",
        "on": true
      },
      "match": "^(?:(?:turn|switch) on|enable|start|activate|put on)\\s+(?:the\\s+)?(?:binge(?:[ -]?(?:mode|watching|watch))?|auto ?play(?:ing)?(?:\\s+mode)?)$|^(?:binge(?:[ -]?(?:mode|watching|watch))?|auto ?play(?:ing)?(?:\\s+mode)?)(?:\\s+on)?$"
    },
    {
      "id": "binge_off",
      "stage": "grammar",
      "do": {
        "type": "binge",
        "on": false
      },
      "match": "^(?:(?:turn|switch) off|disable|stop|deactivate|no(?: more)?|cancel)\\s+(?:the\\s+)?(?:binge(?:[ -]?(?:mode|watching|watch))?|auto ?play(?:ing)?(?:\\s+mode)?)$|^(?:binge(?:[ -]?(?:mode|watching|watch))?|auto ?play(?:ing)?(?:\\s+mode)?)\\s+off$"
    },
    {
      "id": "stop_after_this",
      "stage": "grammar",
      "do": {
        "type": "timer",
        "then": "stop"
      },
      "match": "^(?:stop|end|finish|stop playing|go home)\\s+(?:after|at the end of|when)\\s+(?:this|the|that)\\s*(?:episode|one|movie|film|show|chapter)?(?:\\s+(?:ends|is over|finishes))?$|^this is the last (?:one|episode)(?: for (?:today|tonight|now))?$|^(?:no more|don't play (?:the )?next) episodes?(?: after this(?: one)?)?$",
      "note": "at the end of what's playing: no next episode, back to Home"
    },
    {
      "id": "off_after_this",
      "stage": "grammar",
      "do": {
        "type": "timer",
        "then": "off"
      },
      "match": "^(?:turn off|switch off|turn the tv off|turn it off|shut (?:it )?down|power off|sleep|go to sleep)\\s+(?:the\\s+tv\\s+)?(?:after|at the end of|when)\\s+(?:this|the|that)\\s*(?:episode|one|movie|film|show|chapter)?(?:\\s+(?:ends|is over|finishes))?$"
    },
    {
      "id": "off_in",
      "stage": "grammar",
      "do": {
        "type": "timer",
        "minutes": "{m|minutes!}",
        "then": "off"
      },
      "match": "^(?:turn off|switch off|turn the tv off|turn it off|shut (?:it )?down|power off|sleep|go to sleep)\\s+(?:the\\s+tv\\s+)?(?:in|after)\\s+(?P<m>.+)$"
    },
    {
      "id": "sleep_timer_for",
      "stage": "grammar",
      "do": {
        "type": "timer",
        "minutes": "{m|minutes!}",
        "then": "off"
      },
      "match": "^(?:set\\s+(?:a|the)\\s+)?sleep timer\\s+(?:for\\s+|to\\s+|of\\s+|in\\s+)?(?P<m>.+)$"
    },
    {
      "id": "stop_in",
      "stage": "grammar",
      "do": {
        "type": "timer",
        "minutes": "{m|minutes!}",
        "then": "stop"
      },
      "match": "^(?:stop|stop playing|end it)\\s+(?:in|after)\\s+(?P<m>.+)$"
    },
    {
      "id": "subtitles_off",
      "stage": "grammar",
      "do": {
        "type": "tracks",
        "subtitles": "off"
      },
      "match": "^(?:(?:turn|switch) off|disable|hide|remove|no|stop)\\s+(?:the\\s+)?(?:subtitles|subtitle|subs|captions)$|^(?:subtitles|subtitle|subs|captions)\\s+off$"
    },
    {
      "id": "subtitles_on",
      "stage": "grammar",
      "do": {
        "type": "tracks",
        "subtitles": "on"
      },
      "match": "^(?:(?:turn|switch) on|enable|show|put on|activate|i want|give me)\\s+(?:the\\s+)?(?:subtitles|subtitle|subs|captions)$|^(?:subtitles|subtitle|subs|captions)(?:\\s+on)?$"
    },
    {
      "id": "subtitles_language",
      "stage": "grammar",
      "do": {
        "type": "tracks",
        "subtitles": "{lang|language!}"
      },
      "match": "^(?:(?:turn on|switch to|put on|put|show|use|change to|set|i want|give me)\\s+)?(?:the\\s+)?(?P<lang>(?:simplified |traditional )?[a-z]+(?: (?:simplified|traditional))?)\\s+(?:subtitles|subtitle|subs|captions)(?:\\s+on)?$"
    },
    {
      "id": "subtitles_in",
      "stage": "grammar",
      "do": {
        "type": "tracks",
        "subtitles": "{lang|language!}"
      },
      "match": "^(?:(?:turn on|switch|change|put|set)\\s+)?(?:the\\s+)?(?:subtitles|subtitle|subs|captions)\\s+(?:in|to|into)\\s+(?P<lang>(?:simplified |traditional )?[a-z]+(?: (?:simplified|traditional))?)$"
    },
    {
      "id": "audio_original",
      "stage": "grammar",
      "do": {
        "type": "tracks",
        "audio": "original"
      },
      "match": "^(?:(?:switch|change|go) (?:back )?to |play (?:it )?in |put (?:it )?in |watch (?:it )?in |use )?(?:the )?original (?:audio|language|version|voices|soundtrack)$"
    },
    {
      "id": "audio_language",
      "stage": "grammar",
      "do": {
        "type": "tracks",
        "audio": "{lang|language!}"
      },
      "match": "^(?:(?:switch to|change to|put on|put|use|set|i want)\\s+)?(?:the\\s+)?(?P<lang>(?:simplified |traditional )?[a-z]+(?: (?:simplified|traditional))?)\\s+(?:audio|dub|dubbing|voices|soundtrack|audio track)$"
    },
    {
      "id": "audio_in",
      "stage": "grammar",
      "do": {
        "type": "tracks",
        "audio": "{lang|language!}"
      },
      "match": "^(?:(?:play|put|switch|change|watch)(?: it)?|audio|sound)\\s+(?:in|to|into)\\s+(?P<lang>(?:simplified |traditional )?[a-z]+(?: (?:simplified|traditional))?)$"
    },
    {
      "id": "what_did_they_say",
      "stage": "grammar",
      "do": {
        "type": "replay",
        "seconds": 10
      },
      "match": "^what (?:did|was|were) (?:he|she|they|it|that|you) (?:just )?(?:say|saying)$",
      "note": "back 10 seconds with subtitles on for a moment"
    },
    {
      "id": "show_recent",
      "stage": "grammar",
      "do": {
        "type": "show_list",
        "list": "recent"
      },
      "match": "^what (?:was|were|have) (?:i|we) (?:been )?watching(?: (?:lately|recently|before|last))?$|^what did (?:i|we) (?:watch|see) (?:last|lately|recently)$|^(?:show|open|list|give)(?: me| us)? (?:my |our |the )?(?:continue watching|recently watched|recent (?:shows|stuff|things)|what (?:i|we) (?:was|were) watching)(?: list)?$|^(?:my |our )?(?:continue watching list|recently watched)$",
      "note": "a numbered list of your Continue Watching; “number 2” plays from it"
    },
    {
      "id": "show_new",
      "stage": "grammar",
      "do": {
        "type": "show_list",
        "list": "new"
      },
      "match": "^(?:so )?(?:what'?s|what is) new(?: (?:on|in|for|with) (?:my |our )?(?:shows|series))?(?: this week| today| lately)?$|^(?:is there )?anything new(?: (?:on|in|to watch))?(?: (?:my |our )?(?:shows|series))?$|^(?:(?:are there )?any |show(?: me)? (?:the )?|list (?:the )?)?new episodes(?: (?:of|from|for|on|in) (?:my |our )?(?:shows|series))?$|^what new episodes are (?:there|out)$",
      "note": "the newest episode of each of your shows that you haven't got to"
    },
    {
      "id": "show_movies",
      "stage": "grammar",
      "do": {
        "type": "show_list",
        "list": "movies"
      },
      "match": "^(?:(?:show|list|give)(?: me| us)? (?:some |the )?|(?:are there )?any |what )?(?:new|latest|recent) (?:movies|films|releases)(?: (?:are )?(?:there|out))?$|^what(?:'s| is) new in (?:movies|films|cinema)$",
      "note": "your addons' list of new films (one named “Latest”, else “Trending”)"
    },
    {
      "id": "pick_number",
      "stage": "grammar",
      "do": {
        "type": "pick",
        "number": "{n|number!}"
      },
      "match": "^(?:(?:play|pick|choose|select|open|put on|watch|start|go with|let'?s go with|take|i(?:'ll| will) take)\\s+)?(?:number|option|choice)\\s+(?P<n>\\w+)$",
      "note": "from the list on screen"
    },
    {
      "id": "pick_ordinal",
      "stage": "grammar",
      "do": {
        "type": "pick",
        "number": "{n|number!}"
      },
      "match": "^(?:(?:play|pick|choose|select|open|put on|watch|start|go with|let'?s go with|take|i(?:'ll| will) take)\\s+)?the (?P<n>first|second|third|fourth|fifth|sixth|seventh|eighth|ninth|tenth)(?: one| option| choice)?$"
    },
    {
      "id": "pick_bare_number",
      "stage": "grammar",
      "do": {
        "type": "pick",
        "number": "{n|number!}"
      },
      "match": "^(?P<n>one|two|three|four|five|six|seven|eight|nine|ten|[1-9]|1[0-9]|20)$",
